{
  "manifest_version": 3,
  "name": "Huntern Web Clipper",
  "version": "1.0.0",
  "description": "Clip job postings from any job board straight into your Huntern tracker.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Huntern"
  }
}
